#!/usr/bin/env bash
# Wrapper to call a jim-search HTTP service (local or remote).
# Optional: symlink to ~/.local/bin/jim-search for global access.
#
# Usage:
#   jim-search <query> [top]        # search only (title/url/snippet)
#   jim-search scrape <url> [url..] # fetch full markdown for URLs
#
# Config (env vars, or a token file):
#   JIM_SEARCH_BASE          base URL, default http://127.0.0.1:17492
#   JIM_SEARCH_AUTH_TOKEN    bearer token; falls back to ~/.config/jim-search/token

set -euo pipefail

BASE="${JIM_SEARCH_BASE:-http://127.0.0.1:17492}"
TOKEN="${JIM_SEARCH_AUTH_TOKEN:-}"
if [[ -z "$TOKEN" && -f "$HOME/.config/jim-search/token" ]]; then
    TOKEN="$(tr -d '[:space:]' < "$HOME/.config/jim-search/token")"
fi

AUTH=()
if [[ -n "$TOKEN" ]]; then
    AUTH=(-H "Authorization: Bearer $TOKEN")
fi

if [[ "${1:-}" == "scrape" ]]; then
    shift
    if [[ $# -eq 0 ]]; then
        echo "Usage: jim-search scrape <url> [url...]" >&2
        exit 1
    fi
    urls_json=$(printf '%s\n' "$@" | python3 -c 'import json,sys; print(json.dumps([l.strip() for l in sys.stdin if l.strip()]))')
    curl -s -X POST "$BASE/scrape" \
        -H "Content-Type: application/json" \
        "${AUTH[@]}" \
        -d "{\"urls\": $urls_json}"
    exit 0
fi

QUERY="${1:-}"
TOP="${2:-10}"

if [[ -z "$QUERY" ]]; then
    echo "Usage: jim-search <query> [top] | jim-search scrape <url> [url...]" >&2
    exit 1
fi

curl -s -G "$BASE/search" \
    "${AUTH[@]}" \
    --data-urlencode "q=$QUERY" \
    --data-urlencode "top=$TOP"
