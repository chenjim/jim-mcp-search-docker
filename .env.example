# Brave Search API key: https://api-dashboard.search.brave.com/
BRAVE_API_KEY=

# Firecrawl API key: https://firecrawl.dev/
FIRECRAWL_API_KEY=

# Tavily API key: https://tavily.com/
TAVILY_API_KEY=

# Parallel AI API key: https://platform.parallel.ai/
PARALLEL_API_KEY=
# Parallel search mode: turbo | fast | basic | advanced (default fast, ~700ms)
# PARALLEL_SEARCH_MODE=fast

# Baidu Qianfan AI Search API key: https://console.bce.baidu.com/qianfan/
# 每日免费 100 次，超出 0.036 元/次；只当搜索源用时不要传 model（避免额外大模型费用）
BAIDU_API_KEY=

# DeepSeek Search & Fetch API key: https://platform.deepseek.com/api_keys
# 独立搜索/抓取接口，按成功请求计费（$0.75/1000 次，失败与空结果不计费）。
# 默认只当兜底源（见 JIM_SEARCH_FALLBACK_PROVIDERS），不进日常轮转。
DEEPSEEK_API_KEY=

# 搜索源顺序：random | sequential | 逗号列表 | shuffle:<列表>
# 例：主要轮转四家、把 DeepSeek 也放进轮转（去掉 deepseek 则它退回兜底位）：
# JIM_SEARCH_PROVIDER_ORDER=shuffle:brave,tavily,parallel,baidu,deepseek

# 兜底搜索源（逗号分隔）：主链全部失败/空结果后才调用，排在 DuckDuckGo 之前。
# 已写进 PROVIDER_ORDER 的源会自动去重；未配置 key 或当天熔断的源自动跳过。
# JIM_SEARCH_FALLBACK_PROVIDERS=deepseek

# 结构化请求日志：每次 search/scrape 落一行 JSONL（query、命中源、结果明细），
# 按天分文件，默认保留 30 天。容器内固定为 /app/logs，对应宿主 ./logs/。
# JIM_SEARCH_LOG_DIR=/app/logs
# JIM_SEARCH_LOG_RETENTION_DAYS=30

# Host proxy for outbound requests (container uses host network, so 127.0.0.1 points to host)
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890

# Optional service tuning
# JIM_SEARCH_TIMEOUT=30
# JIM_SEARCH_SCRAPE_TIMEOUT=60
# JIM_SEARCH_MIN_CONTENT_LENGTH=200
# JIM_SEARCH_SCRAPE_CONCURRENCY=5
# JIM_SEARCH_MAX_CHARS=20000

# Bearer token required by /search, /scrape and /mcp.
# Leave empty for localhost-only use; MUST be set before exposing to a network.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JIM_SEARCH_AUTH_TOKEN=

# Comma-separated Host allow-list for the /mcp DNS-rebinding protection.
# Add your LAN IP(s)/domain(s) when calling /mcp over the network.
# JIM_SEARCH_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.31.165

# --- Cookie 通道（可选）-----------------------------------------------------
# cookie.<name>.txt 放在 ./cookies/（已 gitignore，含登录态，勿入库），
# 按域名注入 Cookie 头 + 站点根 Referer。
# 默认映射：toutiao.com→toutiao、baidu.com→baidu、weibo.com→weibo。
# 覆盖或新增时用 JSON（外层单引号）：
# JIM_SEARCH_COOKIE_MAP='{"toutiao.com":"toutiao","example.com":"example"}'
#
# 命中 cookie 的域名优先走直连（快、省 jina/付费额度），失败自动回退常规链路。
# JIM_SEARCH_COOKIE_FIRST=true
#
# 这些域名只走 jina，不做直连——反爬是 JS 挑战，直连必失败（知乎 zse_ck）。
# JIM_SEARCH_JINA_ONLY_DOMAINS=zhihu.com
